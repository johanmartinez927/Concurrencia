vector<thread> crearControladores() {

    vector<thread> controladores;

    for (int i = 0; i < NUM_CONTROLADORES; i++) {

        int id = i + 1;


        int zonaA = i;
        int zonaB = (i + 1) % NUM_ZONAS;

        controladores.push_back(
            thread(
                ejecutarControlador,
                id,
                zonaA,
                zonaB
            )
        );
    }

    return controladores;
}

void esperarControladores(
    vector<thread>& controladores) {

    for (size_t i = 0;
         i < controladores.size();
         i++) {

        controladores[i].join();
    }
}



